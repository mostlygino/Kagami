<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Kagami</title>
    <organization>dev.mostlygino</organization>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64" rootVolumeOnly="true"/>
    <allowed-os-versions><os-version min="26.0"/></allowed-os-versions>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="installer-light.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="installer-dark.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>
    <choices-outline>
        <line choice="app"/>
        <line choice="cli"/>
    </choices-outline>
    <choice id="app" title="Kagami" description="The app, installed in Applications." enabled="false" start_selected="true">
        <pkg-ref id="dev.mostlygino.kagami"/>
    </choice>
    <choice id="cli" title="Command line tool" start_selected="true"
            description="Links the kagami command into /usr/local/bin, for Terminal, scripts and MCP clients such as Claude Code. Leave it off if you only use the app.">
        <pkg-ref id="dev.mostlygino.kagami.cli"/>
    </choice>
    <pkg-ref id="dev.mostlygino.kagami" version="__VERSION__" onConclusion="none">Kagami-app.pkg</pkg-ref>
    <pkg-ref id="dev.mostlygino.kagami.cli" version="__VERSION__" onConclusion="none">Kagami-cli.pkg</pkg-ref>
</installer-gui-script>
